[Unit]
Description=WLED Linux ambient renderer for FPP (alpha)
After=network.target

[Service]
Type=simple
User=fpp
Group=fpp
WorkingDirectory=@PLUGIN_DIR@
ExecStart=/bin/bash "@PLUGIN_DIR@/scripts/run-runtime.sh"
Restart=on-failure
RestartSec=2
TimeoutStopSec=10
UMask=0007
RuntimeDirectory=fpp-wled
RuntimeDirectoryMode=0770
RuntimeDirectoryPreserve=yes
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths="@STATE_DIR@" "@LOG_DIR@" /run/fpp-wled
StandardOutput=append:@LOG_FILE@
StandardError=inherit
# getifaddrs/if_nameindex and zeroconf enumerate interfaces through netlink.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
MemoryMax=256M
TasksMax=64

[Install]
WantedBy=multi-user.target
