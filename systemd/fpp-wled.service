[Unit]
Description=WLED Linux ambient renderer for FPP (alpha)
After=network.target

[Service]
Type=simple
User=fpp
Group=fpp
WorkingDirectory=/home/fpp/media/plugins/FPP_WLED_10.x/build/current
ExecStart=/home/fpp/media/plugins/FPP_WLED_10.x/build/current/.venv/bin/python -m runtime.service
Restart=on-failure
RestartSec=2
TimeoutStopSec=10
UMask=0007
RuntimeDirectory=fpp-wled
RuntimeDirectoryMode=0770
RuntimeDirectoryPreserve=yes
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/fpp/media/config/plugin.FPP_WLED_10.x /run/fpp-wled
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=256M
TasksMax=64

[Install]
WantedBy=multi-user.target
